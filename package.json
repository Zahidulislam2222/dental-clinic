{
  "name": "everyday-dental-surgery",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "audit:compliance": "node compliance/audit.js",
    "audit:json": "node compliance/audit.js --json",
    "audit:ci": "node compliance/audit.js --ci",
    "audit:hipaa": "node compliance/audit.js --category hipaa",
    "audit:fhir": "node compliance/audit.js --category fhir",
    "audit:soc2": "node compliance/audit.js --category soc2",
    "audit:security": "node compliance/audit.js --category security",
    "predeploy": "npm run check",
    "test": "node --test tests/automated/*.test.js",
    "lint": "eslint src scripts tests/automated vite.config.js eslint.config.js",
    "typecheck": "tsc -p tsconfig.json",
    "test:browser": "playwright test",
    "check": "npm run test && npm run typecheck && npm run lint && npm run build"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.101.1",
    "dompurify": "^3.3.3",
    "framer-motion": "^11.15.0",
    "gsap": "^3.14.2",
    "lenis": "^1.3.21",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-helmet-async": "^2.0.5",
    "react-hook-form": "^7.54.0",
    "react-hot-toast": "^2.4.1",
    "react-router-dom": "^7.18.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@types/react": "^18.3.12",
    "@vitejs/plugin-react": "^6.1.1",
    "autoprefixer": "^10.4.20",
    "eslint": "^10.10.0",
    "globals": "^17.12.0",
    "postcss": "^8.4.49",
    "supabase": "^2.84.8",
    "tailwindcss": "^3.4.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.0"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
